# Copy to .env and fill in. .env is git-ignored.
# offline = rule-based stand-in (no key, pipeline check only)
# anthropic = Anthropic Messages API
# openai = any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio)
LLM_PROVIDER=offline
LLM_MODEL=
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Price per million tokens in US$, for cost reporting
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
# Live stack
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093
INVESTIGATOR_API=http://localhost:8080
